{
  "id": "sequencer",
  "title": "Nik's Sequencer",
  "description": "A maintained fork of Sequencer by Fantasy Computerworks, with bug fixes and performance improvements. Keeps the module id \"sequencer\", so modules that depend on Sequencer keep working. Play effects on the canvas and create complex sequences of actions.",
  "version": "4.3.0.n5",
  "library": "false",
  "compatibility": {
    "minimum": "13",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Wasp",
      "discord": "Wasp#2005",
      "website": "http://fantasycomputer.works/"
    },
    {
      "name": "Nik",
      "url": "https://github.com/nschoenwald"
    }
  ],
  "esmodules": [
    "dist/sequencer.js"
  ],
  "styles": [
    "dist/sequencer.css"
  ],
  "flags": {
    "css": {
      "shorthand": "sequencer"
    },
    "hotReload": {
      "extensions": [
        "css",
        "json"
      ],
      "paths": [
        "styles"
      ]
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en-EN.json"
    },
    {
      "lang": "cs",
      "name": "Čeština",
      "path": "languages/cs.json"
    },
    {
      "lang": "it",
      "name": "Italiano",
      "path": "languages/it.json"
    },
    {
      "lang": "ja",
      "name": "日本語",
      "path": "languages/ja.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "languages/es-ES.json"
    },
    {
      "lang": "pl",
      "name": "Polski",
      "path": "languages/pl.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "languages/pt-BR.json"
    }
  ],
  "socket": true,
  "url": "https://github.com/nschoenwald/niks-sequencer",
  "manifest": "https://github.com/nschoenwald/niks-sequencer/releases/latest/download/module.json",
  "download": "https://github.com/nschoenwald/niks-sequencer/releases/latest/download/module.zip",
  "readme": "https://github.com/nschoenwald/niks-sequencer/blob/master/README.md",
  "bugs": "https://github.com/nschoenwald/niks-sequencer/issues",
  "changelog": "https://github.com/nschoenwald/niks-sequencer/blob/master/CHANGELOG.md"
}
